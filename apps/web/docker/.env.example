# cp .env.example .env, then edit. docker compose picks it up automatically.

# ONNX export directory to serve (model.onnx + metadata.json, plus model.onnx.data
# if the exporter wrote one): the release's sa4birds-LT-SSA-onnx.tar extracted at
# the project root, or an ../../../export_onnx.py output. Required. A relative path
# resolves against THIS directory, so the project root is ../../.. -- absolute is
# safer on a server.
SA4BIRDS_MODEL=../../../ckpts/onnx/ssa_LT_seed1

# Host port to publish on. Defaults to 7860.
#SA4BIRDS_PORT=7860
